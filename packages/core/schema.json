{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coding Git Autocommit configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "enabled": { "type": "boolean", "default": true },
    "staging": { "enum": ["all", "staged"], "default": "all" },
    "skipHooks": { "type": "boolean", "default": true },
    "autoInit": { "type": "boolean", "default": false },
    "rootOnly": { "type": "boolean", "default": true },
    "events": { "$ref": "#/$defs/events" },
    "lockTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000, "default": 5000 },
    "gitTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000, "default": 15000 },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claude": { "$ref": "#/$defs/policy" },
        "codex": { "$ref": "#/$defs/policy" },
        "opencode": { "$ref": "#/$defs/policy" }
      }
    }
  },
  "$defs": {
    "events": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "success": { "type": "boolean", "default": true },
        "failure": { "type": "boolean", "default": true },
        "interrupted": { "type": "boolean", "default": true }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "staging": { "enum": ["all", "staged"] },
        "skipHooks": { "type": "boolean" },
        "autoInit": { "type": "boolean" },
        "rootOnly": { "type": "boolean" },
        "events": { "$ref": "#/$defs/events" },
        "lockTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "gitTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 }
      }
    }
  }
}
